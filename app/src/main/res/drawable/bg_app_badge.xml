<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer cyan glow shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#3300D4AA" />
        </shape>
    </item>
    <!-- Inner metallic dark squircle badge -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0A1219" />
            <stroke
                android:width="1.5dp"
                android:color="#00D4AA" />
        </shape>
    </item>
</layer-list>
