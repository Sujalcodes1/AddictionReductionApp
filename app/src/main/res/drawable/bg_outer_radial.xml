<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid dark space base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_outer" />
        </shape>
    </item>
    <!-- Radial cyan aura centered behind card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="0.5"
                android:centerY="0.38"
                android:startColor="#2600D09E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
