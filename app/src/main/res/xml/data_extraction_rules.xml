<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+ cloud backup / device transfer).
    Same strategy as full-backup-content — export app settings only.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />

        <exclude domain="sharedpref" path="auth_session_prefs.xml" />
        <exclude domain="sharedpref" path="db_passphrase_prefs.xml" />
        <exclude domain="sharedpref" path="auth_session_prefs_fallback.xml" />

        <exclude domain="database" path="smartfocus.db" />
        <exclude domain="database" path="smartfocus.db-wal" />
        <exclude domain="database" path="smartfocus.db-shm" />
    </cloud-backup>
</data-extraction-rules>
